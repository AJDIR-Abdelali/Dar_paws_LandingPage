---
import Base from '../../layouts/Base.astro';
import SharedSitter from '../../components/SharedSitter.astro';
import PageState from '../../components/PageState.astro';
import { loadSitter } from '../../lib/api';
import { sitterMeta, respond } from '../../lib/sharePages';
export const prerender = false;
const r = await loadSitter(Astro.params.id);
respond(Astro, r);
const m = r.state === 'ok' ? sitterMeta('fr', r.data.sitter, r.data.total) : null;
---
<Base lang="fr" title={m?.title} description={m?.description} ogImage={m?.image} noindex>
  {r.state === 'ok' ? <SharedSitter lang="fr" {...r.data} /> : <PageState lang="fr" state={r.state} />}
</Base>
