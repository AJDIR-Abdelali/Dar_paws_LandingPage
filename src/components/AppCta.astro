---
// "Open in DarPaws" (Android: opens the app if installed, else Google Play) + share button.
import PlayBadge from './PlayBadge.astro';
import { PLAY_URL, type Lang } from '../i18n/ui';
import { share } from '../i18n/share';
interface Props { lang: Lang; deepPath: string; hint: string }
const { lang, deepPath, hint } = Astro.props;
const s = share[lang];
const intent = `intent://${deepPath}#Intent;scheme=darpaws;package=ma.darpaws.app;S.browser_fallback_url=${encodeURIComponent(PLAY_URL)};end`;
---
<div class="cta">
  <p class="hint">{hint}</p>
  <a class="btn btn-primary open" href={PLAY_URL} data-intent={intent}>{s.openApp}</a>
  <div class="row">
    <PlayBadge lang={lang} size="sm" />
    <button type="button" class="btn btn-ghost btn-sm sharebtn" data-copied={s.copied}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" d="M4 12v7a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-7M16 6l-4-4-4 4M12 2v13"/></svg>
      <span>{s.share}</span>
    </button>
  </div>
</div>

<script>
  // Android browsers open the app through an intent link (falls back to Google Play).
  const open = document.querySelector<HTMLAnchorElement>('.cta .open');
  if (open && /android/i.test(navigator.userAgent)) open.href = open.dataset.intent!;
  const btn = document.querySelector<HTMLButtonElement>('.cta .sharebtn');
  btn?.addEventListener('click', async () => {
    const data = { title: document.title, url: location.href };
    try {
      if (navigator.share) await navigator.share(data);
      else { await navigator.clipboard.writeText(location.href); btn.querySelector('span')!.textContent = btn.dataset.copied!; }
    } catch { /* closed the share sheet */ }
  });
</script>

<style>
  .cta { margin-top: 28px; padding: 22px; border-radius: var(--radius); background: var(--coral-50); display: grid; gap: 14px; }
  .hint { color: var(--ink-2); font-weight: 600; }
  .open { width: 100%; }
  .row { display: flex; gap: 12px; align-items: center; justify-content: space-between; flex-wrap: wrap; }
  .sharebtn { background: var(--bg); cursor: pointer; font-family: inherit; }
</style>
