---
import Phone from './Phone.astro';
import PlayBadge from './PlayBadge.astro';
import PostCard from './PostCard.astro';
import home from '../assets/screens/home.png';
import health from '../assets/screens/health.png';
import map from '../assets/screens/map.png';
import bookings from '../assets/screens/bookings.png';
import { PLAY_URL, t, base, type Lang } from '../i18n/ui';
import type { CollectionEntry } from 'astro:content';

interface Props { lang: Lang; posts: CollectionEntry<'blog'>[] }
const { lang, posts } = Astro.props;
const s = t(lang);
const shots = { health, map, bookings };
const check = `<svg viewBox="0 0 20 20" width="20" height="20" aria-hidden="true"><circle cx="10" cy="10" r="10" fill="#E6F6F4"/><path d="m6 10.2 2.6 2.6L14 7.4" fill="none" stroke="#17A398" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
---
<!-- HERO -->
<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy">
      <span class="eyebrow" data-reveal>{s.hero.eyebrow}</span>
      <h1 data-reveal data-delay="1">{s.hero.title}</h1>
      <p class="lead" data-reveal data-delay="2">{s.hero.lead}</p>
      <div class="hero-cta" data-reveal data-delay="3">
        <PlayBadge lang={lang} />
        <a class="btn btn-ghost" href="#how">{s.hero.secondary}</a>
      </div>
      <ul class="chips" data-reveal data-delay="3">
        {s.hero.chips.map((c) => <li set:html={`${check}<span>${c}</span>`} />)}
      </ul>
    </div>
    <div class="hero-visual" data-reveal data-delay="2">
      <div class="glow" aria-hidden="true"></div>
      <Phone src={home} alt="" eager class="hero-phone" />
      <div class="float float-a" aria-hidden="true">
        <span class="float-icon">💉</span>
        <span><b>{s.hero.float.vaccine.title}</b><small>{s.hero.float.vaccine.text}</small></span>
      </div>
      <div class="float float-b" aria-hidden="true">
        <span class="float-icon ok">✓</span>
        <span><b>{s.hero.float.booking.title}</b><small>{s.hero.float.booking.text}</small></span>
      </div>
    </div>
  </div>
</section>

<!-- FEATURES -->
<section id="features" class="section">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">{s.features.eyebrow}</span>
      <h2 class="h2">{s.features.title}</h2>
    </div>

    {s.features.rows.map((row, i) => (
      <div class:list={['feature', { flip: i % 2 === 1 }]}>
        <div class="feature-visual" data-reveal>
          <Phone src={shots[row.key as keyof typeof shots]} alt="" />
        </div>
        <div class="feature-copy" data-reveal data-delay="1">
          <span class="feature-num">0{i + 1}</span>
          <h3>{row.title}</h3>
          <p>{row.text}</p>
          <ul class="points">
            {row.points.map((p) => <li set:html={`${check}<span>${p}</span>`} />)}
          </ul>
        </div>
      </div>
    ))}

    <div class="mini-grid">
      {s.features.grid.map((g, i) => (
        <div class="mini" data-reveal data-delay={String(i + 1)}>
          <h4>{g.title}</h4>
          <p>{g.text}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- HOW IT WORKS -->
<section id="how" class="section soft">
  <div class="container">
    <div class="section-head center" data-reveal>
      <span class="eyebrow">{s.how.eyebrow}</span>
      <h2 class="h2">{s.how.title}</h2>
    </div>
    <ol class="steps">
      {s.how.steps.map((step, i) => (
        <li data-reveal data-delay={String(i + 1)}>
          <span class="step-num">{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- CARETAKERS -->
<section id="caretakers" class="section">
  <div class="container">
    <div class="band" data-reveal>
      <div class="band-copy">
        <span class="eyebrow light">{s.caretaker.eyebrow}</span>
        <h2 class="h2">{s.caretaker.title}</h2>
        <p>{s.caretaker.text}</p>
        <a class="btn btn-white" href={PLAY_URL} target="_blank" rel="noopener">{s.caretaker.cta}</a>
      </div>
      <div class="band-visual" aria-hidden="true">
        <div class="req-stack">
          {s.caretaker.cards.map((c, i) => (
            <div class:list={['req', { accepted: i === 1 }]}>
              <div class="req-avatar">{c.name.slice(0, 1)}</div>
              <div class="req-body">
                <b>{c.name}</b>
                <span>{c.meta}</span>
                <small>{c.when}</small>
              </div>
              <span class="req-status">{c.status}</span>
            </div>
          ))}
          <div class="rate"><span>{s.caretaker.rate}</span><b>{s.caretaker.rateValue}</b></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- BLOG -->
{posts.length > 0 && (
  <section id="blog" class="section soft">
    <div class="container">
      <div class="blog-head" data-reveal>
        <div>
          <span class="eyebrow">{s.blog.eyebrow}</span>
          <h2 class="h2">{s.blog.title}</h2>
        </div>
        <a class="btn btn-ghost" href={`${base(lang)}/blog`}>{s.blog.all}</a>
      </div>
      <div class="posts">
        {posts.slice(0, 3).map((p, i) => <div data-reveal data-delay={String(i + 1)}><PostCard post={p} lang={lang} /></div>)}
      </div>
    </div>
  </section>
)}

<!-- FAQ -->
<section id="faq" class="section">
  <div class="container faq-wrap">
    <div class="section-head" data-reveal>
      <span class="eyebrow">{s.faq.eyebrow}</span>
      <h2 class="h2">{s.faq.title}</h2>
    </div>
    <div class="faq-list" data-reveal data-delay="1">
      {s.faq.items.map((f) => (
        <details>
          <summary>{f.q}<span class="plus" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<!-- FINAL CTA -->
<section class="section final-wrap">
  <div class="container final" data-reveal>
    <h2 class="h2">{s.final.title}</h2>
    <p class="lead">{s.final.text}</p>
    <PlayBadge lang={lang} />
  </div>
</section>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 8vw, 96px) clamp(64px, 9vw, 120px); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr .9fr; gap: 56px; align-items: center; }
  h1 { font-size: clamp(44px, 7vw, 84px); }
  .hero .lead { max-width: 30ch; font-size: clamp(19px, 1.8vw, 22px); }
  .hero-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 14px; margin-top: 36px; }
  .hero-cta .btn { height: 56px; padding-inline: 26px; }
  .chips { display: flex; flex-wrap: wrap; gap: 20px; list-style: none; padding: 0; margin: 28px 0 0; }
  .chips li, .points li { display: flex; align-items: center; gap: 8px; font-weight: 600; color: var(--ink-2); font-size: 15px; }

  .hero-visual { position: relative; display: flex; justify-content: center; }
  .glow {
    position: absolute; inset: 6% 2% 0; z-index: -1; border-radius: 50%;
    background: radial-gradient(closest-side, rgba(232, 93, 78, .22), transparent);
    filter: blur(20px);
  }
  .hero-visual :global(.hero-phone) { max-width: 330px; transform: rotate(-2deg); }
  :lang(ar) .hero-visual :global(.hero-phone) { transform: rotate(2deg); }
  .float {
    position: absolute; display: flex; align-items: center; gap: 12px;
    background: #fff; border-radius: 18px; padding: 12px 18px 12px 12px;
    box-shadow: 0 20px 40px -12px rgba(21, 22, 31, .22), 0 0 0 1px var(--line);
    animation: bob 6s ease-in-out infinite;
  }
  :lang(ar) .float { padding: 12px 12px 12px 18px; }
  .float b { display: block; font-size: 15px; }
  .float small { display: block; color: var(--muted); font-size: 13px; }
  .float-icon { display: grid; place-items: center; width: 40px; height: 40px; border-radius: 12px; background: var(--coral-50); font-size: 20px; }
  .float-icon.ok { background: #E6F6F4; color: var(--teal); font-weight: 800; }
  .float-a { top: 18%; inset-inline-start: -4%; }
  .float-b { bottom: 14%; inset-inline-end: -6%; animation-delay: -3s; }
  @keyframes bob { 50% { transform: translateY(-10px); } }

  /* Feature rows */
  .feature { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(40px, 8vw, 120px); align-items: center; padding-block: clamp(32px, 5vw, 56px); }
  .feature.flip .feature-visual { order: 2; }
  .feature-visual {
    display: flex; justify-content: center; padding-block: 48px;
    background: var(--bg-soft); border-radius: var(--radius-lg);
  }
  .feature-visual :global(.phone) { max-width: 280px; }
  .feature-num { display: block; font-weight: 800; color: var(--coral); font-size: 15px; margin-bottom: 14px; }
  .feature h3 { font-size: clamp(28px, 3.4vw, 40px); }
  .feature-copy > p { color: var(--ink-2); font-size: 18px; margin-top: 18px; max-width: 42ch; }
  .points { list-style: none; padding: 0; margin: 28px 0 0; display: grid; gap: 12px; }
  .points li { font-size: 16px; color: var(--ink); }

  .mini-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: clamp(40px, 6vw, 72px); }
  .mini { border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
  .mini h4 { margin: 0 0 8px; font-size: 18px; letter-spacing: -0.01em; }
  .mini p { color: var(--ink-2); font-size: 15px; }

  /* Steps */
  .soft { background: var(--bg-soft); }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; counter-reset: none; }
  .steps li { background: #fff; border-radius: var(--radius); padding: 32px; box-shadow: var(--shadow-sm); }
  .step-num { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 14px; background: var(--ink); color: #fff; font-weight: 800; margin-bottom: 24px; }
  .steps h3 { font-size: 22px; letter-spacing: -0.02em; }
  .steps p { color: var(--ink-2); margin-top: 8px; }

  /* Caretaker band */
  .band {
    display: grid; grid-template-columns: 1.1fr .9fr; gap: 40px; align-items: end;
    background: var(--coral); color: #fff; border-radius: var(--radius-lg);
    padding: clamp(36px, 6vw, 72px) clamp(28px, 6vw, 72px) 0; overflow: hidden;
  }
  .band-copy { padding-bottom: clamp(36px, 6vw, 72px); align-self: center; }
  .band .h2 { color: #fff; }
  .band p { font-size: 18px; opacity: .92; margin-top: 18px; max-width: 40ch; }
  .eyebrow.light { color: #fff; opacity: .85; }
  .btn-white { background: #fff; color: var(--coral); margin-top: 32px; }
  .btn-white:hover { transform: translateY(-1px); }
  .band { align-items: center; padding-bottom: clamp(36px, 6vw, 72px); }
  .band-copy { padding-bottom: 0; }
  .band-visual { display: flex; justify-content: center; }
  .req-stack { width: 100%; max-width: 400px; display: grid; gap: 14px; }
  .req {
    display: flex; align-items: center; gap: 14px;
    background: #fff; color: var(--ink); border-radius: 20px; padding: 16px 18px;
    box-shadow: 0 24px 48px -20px rgba(0,0,0,.35);
  }
  .req:nth-child(2) { margin-inline-start: 36px; }
  .req-avatar { flex: none; width: 44px; height: 44px; border-radius: 50%; display: grid; place-items: center; background: var(--coral-50); color: var(--coral); font-weight: 800; }
  .req.accepted .req-avatar { background: #E6F6F4; color: var(--teal); }
  .req-body { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  .req-body b { font-size: 16px; }
  .req-body span { font-size: 14px; color: var(--ink-2); }
  .req-body small { font-size: 13px; color: var(--muted); }
  .req-status { margin-inline-start: auto; flex: none; font-size: 12px; font-weight: 700; padding: 6px 10px; border-radius: 999px; background: var(--coral-50); color: var(--coral); }
  .req.accepted .req-status { background: #E6F6F4; color: var(--teal); }
  .rate { justify-self: start; display: flex; flex-direction: column; background: rgba(255,255,255,.16); border: 1px solid rgba(255,255,255,.35); border-radius: 16px; padding: 12px 18px; color: #fff; }
  .rate span { font-size: 13px; opacity: .85; }
  .rate b { font-size: 22px; }

  /* Blog */
  .blog-head { display: flex; justify-content: space-between; align-items: flex-end; gap: 20px; flex-wrap: wrap; margin-bottom: 48px; }
  .posts { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }

  /* FAQ */
  .faq-wrap { display: grid; grid-template-columns: .8fr 1.2fr; gap: 56px; align-items: start; }
  .faq-list { border-top: 1px solid var(--line); }
  details { border-bottom: 1px solid var(--line); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 24px 0; font-weight: 700; font-size: 18px; }
  summary::-webkit-details-marker { display: none; }
  .plus { position: relative; flex: none; width: 20px; height: 20px; }
  .plus::before, .plus::after { content: ''; position: absolute; inset: 9px 2px auto; height: 2px; background: var(--ink); border-radius: 2px; transition: transform .25s ease; }
  .plus::after { transform: rotate(90deg); }
  details[open] .plus::after { transform: rotate(0); }
  details p { color: var(--ink-2); padding-bottom: 24px; max-width: 60ch; }

  /* Final */
  .final-wrap { padding-top: 0; }
  .final { text-align: center; display: flex; flex-direction: column; align-items: center; gap: 0; background: var(--bg-soft); border-radius: var(--radius-lg); padding: clamp(48px, 8vw, 96px) 24px; }
  .final .lead { margin-bottom: 32px; }

  /* Responsive */
  @media (max-width: 960px) {
    .hero-grid { grid-template-columns: 1fr; text-align: center; }
    .hero .lead { margin-inline: auto; }
    .hero-cta, .chips { justify-content: center; }
    .hero-visual { margin-top: 24px; }
    .float-a { inset-inline-start: 2%; }
    .float-b { inset-inline-end: 2%; }
    .feature, .feature.flip { grid-template-columns: 1fr; gap: 32px; }
    .feature.flip .feature-visual { order: 0; }
    .mini-grid, .steps, .posts { grid-template-columns: 1fr; }
    .band { grid-template-columns: 1fr; text-align: center; }
    .band p { margin-inline: auto; }
    .req-stack { margin-inline: auto; }
    .req:nth-child(2) { margin-inline-start: 0; }
    .rate { justify-self: center; }
    .faq-wrap { grid-template-columns: 1fr; gap: 8px; }
  }
  @media (max-width: 600px) {
    .hero-visual :global(.hero-phone) { max-width: 250px; }
    .float { padding: 10px 14px 10px 10px; border-radius: 14px; }
    .float b { font-size: 13px; }
    .float small { font-size: 12px; }
    .float-icon { width: 32px; height: 32px; font-size: 16px; border-radius: 10px; }
    .float-a { top: 8%; inset-inline-start: 0; }
    .float-b { bottom: 8%; inset-inline-end: 0; }
    .feature-visual { padding-block: 32px; }
    .feature-visual :global(.phone) { max-width: 230px; }
    .hero-cta .btn { width: 100%; max-width: 320px; }
  }
</style>
