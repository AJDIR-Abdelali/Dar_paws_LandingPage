---
// Shared page that can't be shown: removed (404) or the API is still waking up (reloads itself).
import { base, type Lang } from '../i18n/ui';
import { share } from '../i18n/share';
interface Props { lang: Lang; state: 'missing' | 'busy' }
const { lang, state } = Astro.props;
const s = share[lang];
---
<section class="section">
  <div class="container" style="text-align:center;max-width:560px">
    {state === 'busy' ? (
      <>
        <div class="spin" aria-hidden="true"></div>
        <h1 class="h2">{s.busy}</h1>
        <p class="lead">{s.busyText}</p>
        <script is:inline>setTimeout(() => location.reload(), 6000);</script>
      </>
    ) : (
      <>
        <p class="eyebrow">404</p>
        <h1 class="h2">{s.notFound}</h1>
        <p class="lead" style="margin-bottom:28px">{s.notFoundText}</p>
        <a class="btn btn-primary" href={base(lang) || '/'}>DarPaws</a>
      </>
    )}
  </div>
</section>

<style>
  .spin { width: 44px; height: 44px; margin: 0 auto 24px; border-radius: 50%; border: 4px solid var(--coral-50); border-top-color: var(--coral); animation: spin 1s linear infinite; }
  @keyframes spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .spin { animation-duration: 3s; } }
</style>
