---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; eager?: boolean; class?: string }
const { src, alt, eager = false, class: cls } = Astro.props;
---
<div class:list={['phone', cls]}>
  <Image
    src={src}
    alt={alt}
    widths={[320, 480, 640]}
    sizes="(max-width: 700px) 70vw, 320px"
    loading={eager ? 'eager' : 'lazy'}
    fetchpriority={eager ? 'high' : 'auto'}
  />
</div>

<style>
  .phone {
    width: 100%;
    max-width: 320px;
    border-radius: 44px;
    padding: 10px;
    background: #101014;
    box-shadow: var(--shadow-lg), inset 0 0 0 1.5px #2a2a30;
  }
  .phone :global(img) { border-radius: 34px; width: 100%; }
</style>
